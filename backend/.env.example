# ==============================================================================
# FreshHarvest Backend Environment Configuration Template (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or Cloud Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/freshharvest

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_freshharvest123
RAZORPAY_KEY_SECRET=freshharvest_secret_key_123
